# ==========================================================
# Adlos MCP Host-Server Konfiguration (.env)
# ==========================================================

# 1. Adlos Einstellungen (Leer lassen für Standard-Relay)
ADLOS_SERVER_URL=
# Wenn ADLOS_BOT_ID=auto und ADLOS_BOT_NAME=auto gesetzt sind (Standard),
# berechnet jeder Rechner automatisch aus seinem Linux-Hostnamen (z.B. 'biene')
# eine eindeutige 15-stellige Kontakt-ID und heißt z.B. "Ubuntu (biene)".
# So kannst du das Projekt ohne Änderung auf beliebig vielen Rechnern nutzen!
ADLOS_BOT_ID=auto
ADLOS_BOT_NAME=auto
ADLOS_TOKEN=
ADLOS_NOTIFY_ON_BOOT=true

# Port für das integrierte QR-Code & Status Web-Dashboard (http://<rechner-ip>:8787)
ADLOS_WEB_PORT=8787

# 2. KI-Provider Einstellungen (Standard: gemini)
# Unterstützte Provider: gemini | openai | ollama
AI_PROVIDER=gemini

# Google Gemini (Standard: gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Alternativ: OpenAI / OpenRouter / Anthropic-kompatibel
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Alternativ: Lokales Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# 3. Ubuntu Host / Keyring / Sudo (Optional)
# HINWEIS: Diese Datei (.env) wird mit chmod 600 geschützt (nur für User kai lesbar).
HOST_USER_PASSWORD=
